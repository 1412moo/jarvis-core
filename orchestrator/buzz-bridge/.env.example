# Copy to .env in this directory (untracked - covered by repo-root
# .gitignore `.env` rule at any depth, verified with `git check-ignore`).
# Never put real values in a tracked file.
#
# Pubkeys are NOT read from here - configs/buzz-agent-identities.json
# (tracked) is the single source of truth for pubkeys. Only the private
# key VALUES live here, one per `private_key_env` name declared in that
# file. The channel is discovered by name at startup (lib/constants.js),
# not configured here.

RELAY_URL=ws://localhost:3000
JARVIS_ORCHESTRATOR_PRIVKEY=CHANGE_ME_64_HEX
AGENT_CLAUDE_PRIVKEY=CHANGE_ME_64_HEX
