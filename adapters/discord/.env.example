# Discord bot token (required)
DISCORD_BOT_TOKEN=

# Owner allowlist for privileged commands (required).
# Comma-separated Discord user IDs, e.g. JARVIS_OWNER_DISCORD_USER_IDS=111111111111111111,222222222222222222
# Only these users may run /approve, /run, /retry, /task.
# Read-only commands (/status, /report, /help, /plan, /review-task, /retro) stay open.
# If unset or containing no valid id, the bot refuses to start (fail-closed).
JARVIS_OWNER_DISCORD_USER_IDS=
